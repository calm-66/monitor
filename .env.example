# 数据库连接字符串 (Neon PostgreSQL)
# 格式：postgresql://user:password@host:port/database?sslmode=require
MONITOR_DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Dashboard 访问密码 (HTTP Basic Auth)
# 用于保护监控面板，防止未授权访问
DASHBOARD_PASSWORD="your_secure_password_here"

# 可选：指定允许的 CORS 域名（逗号分隔）
# 留空表示允许所有域名（开发环境），生产环境建议指定具体域名
ALLOWED_ORIGINS=""

# 可选：日志级别 (debug, info, warn, error)
LOG_LEVEL="info"