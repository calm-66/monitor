# 数据库连接字符串 (Neon PostgreSQL)
# 格式：postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Dashboard 访问密码 (HTTP Basic Auth)
# 用于保护监控面板，防止未授权访问
DASHBOARD_PASSWORD="your_secure_password_here"

# 可选：指定允许的 CORS 域名（逗号分隔）
# 留空表示允许所有域名（开发环境），生产环境建议指定具体域名
ALLOWED_ORIGINS=""

# 可选：日志级别 (debug, info, warn, error)
LOG_LEVEL="info"

# UsOnly 独立 Project 配置（用于区分 Preview/Production 环境）
# 在 Neon 数据库中执行 scripts/create-separate-projects.sql 创建项目后获取 API Key
# USONLY_PREVIEW_PROJECT_ID=""        # usonly-preview 项目的 ID (UUID)
# USONLY_PREVIEW_API_KEY=""            # usonly-preview 项目的 API Key (mk_preview_xxx)
# USONLY_PRODUCTION_PROJECT_ID=""      # usonly-production 项目的 ID (UUID)
# USONLY_PRODUCTION_API_KEY=""         # usonly-production 项目的 API Key (mk_production_xxx)
